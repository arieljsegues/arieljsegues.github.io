		<section class="cv-section cv-achievements">
			<div class="cv-label">
				<p class="section-label">ACHIEVEMENT</p>
			</div>

			<div class="cv-content">
				<div class="achievement">
					<span>2024 · FEBRUARY</span>

					<p>
						High Honours in Mixing & Mastering with
						Toni Castaño.
					</p>
				</div>
			</div>
		</section>

		<section class="cv-section cv-contact">
			<div class="cv-label">
				<p class="section-label">CONTACT</p>
			</div>

			<div class="cv-content">
				<a href="mailto:arieljsegues@gmail.com">
					arieljsegues@gmail.com
				</a>

				<a
					href="https://wa.me/34717708066"
					target="_blank"
					rel="noopener noreferrer"
				>
					+34 717 708 066
				</a>

				<a
					href="https://arieljsegues.com"
					target="_blank"
					rel="noopener noreferrer"
				>
					arieljsegues.com
				</a>
			</div>
