---
import Layout from "../layouts/layout.astro";
---

<Layout
	title="CV — Ariel Jiménez Segués"
	description="CV of Ariel Jiménez Segués, sound designer."
>
	<main>
		<section class="cv-hero">
			<p class="eyebrow">CURRICULUM VITAE</p>

			<h1>
				Ariel Jiménez<br />
				Segués.
			</h1>

			<p class="intro">
				SOUND DESIGNER
			</p>

			<p class="cv-contact-line">
				Barcelona, Spain ·
				<a href="mailto:arieljsegues@gmail.com">
					 arieljsegues@gmail.com 
				</a>
				+34 717 708 066 ·
				<a
					href="https://arieljsegues.com"
					target="_blank"
					rel="noopener noreferrer"
				>
					arieljsegues.com
				</a>
			</p>

			<a
				class="cv-download"
				href="/cv/ariel-segues-cv.pdf"
				download
			>
				Download CV ↗
			</a>
		</section>

		<section class="cv-section cv-profile">
			<div class="cv-label">
				<p class="section-label">PROFILE</p>
			</div>

			<div class="cv-content">
				<p class="cv-lead">
					Sound Designer working across audiovisual and interactive
					media, with a background in music production, audio
					engineering and computer science.
				</p>

				<p>
					Experienced in creating sound for videogames, animation
					and immersive audiovisual installations, with a focus on
					detailed sonic environments, character and creature sound,
					and narrative-driven audio.
				</p>
			</div>
		</section>

		<section class="cv-section">
			<div class="cv-label">
				<p class="section-label">EXPERIENCE</p>
			</div>

			<div class="cv-content">
				<article class="cv-entry">
					<div class="cv-date">2025 — PRESENT</div>

					<div class="cv-entry-body">
						<h2>Self-Employed Sound Designer</h2>

						<div class="cv-role">
							<h3>Framemov</h3>

							<p class="cv-company">
								Jan 2026 — Present
							</p>

							<ul>
								<li>
									Sound design for immersive audiovisual
									installations and cinematic experiences.
								</li>

								<li>
									Sound design for immersive rooms,
									large-format screens and videomapping
									projects.
								</li>

								<li>
									Creation of atmospheres, effects and
									sonic environments to support visual
									narratives.
								</li>

								<li>
									Adapting sound to large-scale
									audiovisual installations and spatial
									experiences.
								</li>
							</ul>
						</div>

						<div class="cv-role">
							<h3>5frame Studios</h3>

							<p class="cv-company">
								Feb 2026 — Present
							</p>

							<ul>
								<li>
									Sound design for videogames and animated
									content.
								</li>

								<li>
									Sound effects for bosses, creatures,
									animals, spells, character actions and
									gameplay animations.
								</li>

								<li>
									Designing and editing sounds to match
									animation, timing and visual performance.
								</li>

								<li>
									Creating detailed and expressive assets
									for interactive and game environments.
								</li>
							</ul>
						</div>
					</div>
				</article>

				<article class="cv-entry">
					<div class="cv-date">2024 — 2025</div>

					<div class="cv-entry-body">
						<h2>Mixing & Mastering Assistant</h2>

						<p class="cv-company">
							Jan Valls Estudio
						</p>

						<ul>
							<li>
								Audio editing, mixing and mastering.
							</li>

							<li>
								Optimisation for different distribution
								platforms and formats.
							</li>

							<li>
								Work with analogue hardware and professional
								audio software.
							</li>

							<li>
								Pro Tools, Logic Pro and Reaper.
							</li>
						</ul>
					</div>
				</article>
			</div>
		</section>

		<section class="cv-section">
			<div class="cv-label">
				<p class="section-label">CORE SKILLS</p>
			</div>

			<div class="cv-content">
				<div class="cv-skills-text">
					<p>
						Sound Design · Sound Editing · Foley · Dialogue Editing
					</p>

					<p>
						Ambience & Atmospheres · Creature & Character Sound
					</p>

					<p>
						Interactive Audio · Audio Implementation · Mixing
						· Mastering
					</p>

					<p>
						Music Composition
					</p>
				</div>
			</div>
		</section>

		<section class="cv-section cv-two-column">
			<div class="cv-block">
				<p class="section-label">TOOLS & TECHNICAL</p>

				<div class="cv-subsection">
					<p class="cv-subsection-label">INTERACTIVE AUDIO</p>

					<div class="cv-list">
						<span>Wwise</span>
						<span>FMOD</span>
						<span>Unity</span>
						<span>Unreal Engine</span>
						<span>Godot</span>
					</div>
				</div>

				<div class="cv-subsection">
					<p class="cv-subsection-label">DAWs</p>

					<div class="cv-list">
						<span>Pro Tools</span>
						<span>Reaper</span>
						<span>Logic Pro</span>
					</div>
				</div>

				<div class="cv-subsection">
					<p class="cv-subsection-label">PROGRAMMING</p>

					<div class="cv-list">
						<span>C#</span>
						<span>C++</span>
						<span>Lua</span>
						<span>Python</span>
					</div>
				</div>
			</div>

			<div class="cv-block">
				<p class="section-label">LANGUAGES</p>

				<div class="language-list">
					<div>
						<span>Spanish</span>
						<span>Native</span>
					</div>

					<div>
						<span>Catalan</span>
						<span>Native</span>
					</div>

					<div>
						<span>English</span>
						<span>B2</span>
					</div>
				</div>
			</div>
		</section>

		<section class="cv-section">
			<div class="cv-label">
				<p class="section-label">EDUCATION</p>
			</div>

			<div class="cv-content">
				<article class="cv-entry">
					<div class="cv-date">2020 — 2024</div>

					<div class="cv-entry-body">
						<h2>
							Sound Design & Music Production
						</h2>

						<p class="cv-company">
							ENTI · Universitat de Barcelona
						</p>

						<ul>
							<li>
								Sound design and music for videogames.
							</li>

							<li>
								Music production and composition.
							</li>

							<li>
								Recording and foley.
							</li>
						</ul>
					</div>
				</article>

				<article class="cv-entry">
					<div class="cv-date">2020 — 2024</div>

					<div class="cv-entry-body">
						<h2>
							Computer Engineering
						</h2>

						<p class="cv-company">
							Universitat Politècnica de Catalunya
						</p>

						<ul>
							<li>
								Completed third year.
							</li>

							<li>
								C++, C#, Python, Java and Lua.
							</li>

							<li>
								Computer architecture.
							</li>
						</ul>
					</div>
				</article>
			</div>
