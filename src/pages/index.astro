
---
import { getCollection } from "astro:content";
import Layout from "../layouts/layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = await getCollection("projects");

const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<Layout
  title="Ariel J. Segués — Immersive Audio & Sound Design"
  description="Immersive audio and spatial sound design for audiovisual installations, exhibitions and interactive experiences. Surround and multichannel audio."
>
  <main>
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-topline">
        <p class="eyebrow">Immersive Audio / Spatial Sound Design</p>

        <span class="hero-availability">
          <span class="availability-dot" aria-hidden="true"></span>
          Available for selected projects
        </span>
      </div>

      <div class="hero-layout">
        <div class="hero-copy">
          <h1 id="hero-title">
            Sound beyond<br />
            <em>stereo.</em>
          </h1>

          <p class="intro">
            I create and mix sound for immersive spaces, audiovisual
            installations and experiences — shaping how sound moves
            through and interacts with an environment.
          </p>

          <div class="hero-footer">
            <a class="hero-work-link" href="#work">
              Explore selected work <span aria-hidden="true">↘</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section id="work" class="work">
      <div class="section-topline">
        <p class="section-label">01 / Selected work</p>
        <span class="availability-link">A selection of projects</span>
      </div>

      <div class="projects">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="about" aria-labelledby="about-heading">
      <div class="section-topline">
        <p id="about-heading" class="section-label">02 / About</p>

        <a href="/about" class="availability-link">
          More about me <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="about-text">
        I work with sound as a way of <em>shaping space and experience.</em>
        Combining sound design, spatial composition and multichannel
        mixing, I create sonic environments for installations,
        exhibitions and audiovisual projects.
      </p>

      <div class="format-line">
        <span class="format-label">Multichannel formats</span>
        <span class="format-values">5.1 <i>·</i> 4.1.1 <i>·</i> 7.2</span>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact-cta" aria-labelledby="contact-cta-heading">
      <div class="contact-cta-content">
        <p class="section-label">03 / Get in touch</p>

        <h2 id="contact-cta-heading">
          Let's make<br />
          <em>space for sound.</em>
        </h2>

        <p>
          Have an installation, exhibition or audiovisual project in mind?
          I'd love to hear about it.
        </p>
      </div>

      <a class="contact-cta-link" href="/contact">
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</Layout>

<style>
  .format-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .format-label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .format-values {
    color: var(--text);
    font-size: clamp(17px, 2vw, 23px);
    letter-spacing: 0.025em;
  }

  .format-values i {
    padding: 0 8px;
    color: var(--accent);
    font-style: normal;
  }

  @media (max-width: 600px) {
    .format-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
