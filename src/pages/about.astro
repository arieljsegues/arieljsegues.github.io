---
import Layout from "../layouts/layout.astro";
---

<Layout
	title="About — Ariel Segues"
	description="Ariel Segues is a sound designer and technical audio designer based in Barcelona, working remotely worldwide."
>
	<main>
		<section class="about-hero">
			<p class="eyebrow">ABOUT</p>

			<h1>
				Sound designer &
				<br />
				technical audio designer.
			</h1>

			<p class="intro">
				I design and implement sound for games and interactive
				media, working remotely with teams worldwide.
			</p>
		</section>

		<section class="about-content">
			<div class="about-column">
				<p class="section-label">PROFILE</p>

				<div class="about-text">
					<p>
						My work combines sound design with technical audio
						implementation. I create detailed, expressive sound
						and bring it into the game through Wwise, FMOD,
						Unity and Unreal Engine.
					</p>

					<p>
						I am particularly interested in gameplay audio,
						characters and creatures, environments, UI and
						interactive systems that respond to what is
						happening on screen.
					</p>

					<p>
						My background in music production, audio engineering
						and computer science allows me to approach projects
						from both the creative and technical sides.
					</p>
				</div>
			</div>

			<div class="about-column">
				<p class="section-label">SERVICES</p>

				<div class="services">
					<div class="service">
						<span>01</span>
						<strong>Game Sound Design</strong>
					</div>

					<div class="service">
						<span>02</span>
						<strong>Audio Implementation</strong>
					</div>

					<div class="service">
						<span>03</span>
						<strong>Technical Audio</strong>
					</div>

					<div class="service">
						<span>04</span>
						<strong>Custom SFX</strong>
					</div>

					<div class="service">
						<span>05</span>
						<strong>Sound Editing</strong>
					</div>

					<div class="service">
						<span>06</span>
						<strong>Audiovisual Sound</strong>
					</div>
				</div>
			</div>
		</section>

		<section class="about-credits">
			<div>
				<p class="section-label">LOCATION</p>
				<p>Barcelona, Spain</p>
			</div>

			<div>
				<p class="section-label">WORKING WITH</p>
				<p>
					Indie game developers · Game studios · Interactive
					projects · Audiovisual productions
				</p>
			</div>

			<div>
				<p class="section-label">AVAILABILITY</p>
				<p>Remote · Worldwide</p>
			</div>
		</section>

		<section class="about-photo">
			<img
				src="/images/about.jpg"
				alt="Ariel Jimenez Segues"
				loading="lazy"
			/>
		</section>
	</main>
</Layout>