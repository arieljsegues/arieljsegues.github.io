---
import Layout from "../layouts/layout.astro";
---

<Layout
	title="About — Ariel"
	description="About Ariel, sound designer and sound editor."
>
	<main>
		<section class="about-hero">
			<p class="eyebrow">ABOUT</p>

			<h1>
				Sound designer
				<br />
				based in Barcelona.
			</h1>

			<p class="intro">
				I work with sound to build atmosphere, emotion and narrative
				across film, games and audiovisual projects.
			</p>
		</section>

		<section class="about-content">
			<div class="about-column">
				<p class="section-label">PROFILE</p>

				<div class="about-text">
					<p>
						My work focuses on sound design, sound editing,
						foley, dialogue and mixing.
					</p>

					<p>
						I am interested in the relationship between sound
						and image, and in creating detailed sonic worlds
						that support the story without distracting from it.
					</p>
				</div>
			</div>

			<div class="about-column">
				<p class="section-label">SERVICES</p>

				<div class="services">
					<div class="service">
						<span>01</span>
						<strong>Sound Design</strong>
					</div>

					<div class="service">
						<span>02</span>
						<strong>Sound Editing</strong>
					</div>

					<div class="service">
						<span>03</span>
						<strong>Foley</strong>
					</div>

					<div class="service">
						<span>04</span>
						<strong>Dialogue Editing</strong>
					</div>

					<div class="service">
						<span>05</span>
						<strong>Mixing</strong>
					</div>

					<div class="service">
						<span>06</span>
						<strong>Game Audio</strong>
					</div>
				</div>
			</div>
		</section>

		<section class="about-credits">
			<div>
				<p class="section-label">LOCATION</p>
				<p>Barcelona, Spain</p>
			</div>

			<div>
				<p class="section-label">AVAILABLE FOR</p>
				<p>Film · Games · Advertising · Other audiovisual projects</p>
			</div>
		</section>

		<section class="about-contact">
			<p class="section-label">LET'S WORK TOGETHER</p>

			<a href="mailto:arieljsegues@gmail.com">
				arieljsegues@gmail.com
			</a>
		</section>

		<section class="about-photo">
			<img
				src="/images/about.jpg"
				alt="Ariel Jimenez Segues"
				loading="lazy"
			/>
		</section>
	</main>
</Layout>

