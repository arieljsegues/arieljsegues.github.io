---
import Layout from "../layouts/layout.astro";
---

<Layout
	title="Contact — Ariel"
	description="Contact Ariel for sound design, sound editing and audiovisual projects."
>
	<main>
		<section class="contact-hero">
			<p class="eyebrow">CONTACT</p>

			<h1>
				Let's make
				<br />
				some noise.
			</h1>

			<p class="intro">
				For projects, collaborations, enquiries or just to say hello.
			</p>
		</section>

		<section class="contact-methods">
			<a
				class="contact-method"
				href="mailto:arieljsegues@gmail.com"
			>
				<div>
					<p class="section-label">EMAIL</p>
					<h2>arieljsegues@gmail.com</h2>
				</div>

				<span class="contact-arrow">↗</span>
			</a>

			<a
				class="contact-method"
				href="https://wa.me/34717708066"
				target="_blank"
				rel="noopener noreferrer"
			>
				<div>
					<p class="section-label">WHATSAPP</p>
					<h2>+34 717 708 066</h2>
				</div>

				<span class="contact-arrow">↗</span>
			</a>
		</section>
	</main>
</Layout>