
---
import Layout from "../layouts/layout.astro";
---

<Layout
	title="Contact — Ariel"
	description="Contact Ariel for sound design, sound editing and audiovisual projects."
>
	<main class="contact-page">
		<section class="contact-hero">
			<p class="eyebrow"><span class="status-dot"></span> CONTACT / 01</p>

			<h1>
				Let's make
				<br />
				<span>some noise.</span>
			</h1>

			<p class="intro">
				For projects, collaborations, enquiries or just to say hello.
				Tell me what you're working on.
			</p>

			<div class="hero-index" aria-hidden="true">
				<span>AVAILABLE FOR SELECT PROJECTS</span>
				<span>41°23' N — 02°10' E</span>
			</div>
		</section>

		<section class="contact-form-section" aria-labelledby="form-title">
			<div class="form-intro">
				<p class="section-label">START A CONVERSATION / 02</p>
				<h2 id="form-title">What's the project?</h2>
				<p>
					Share a few details and I'll get back to you by email.
				</p>

				<div class="form-note">
					<span class="note-symbol">↳</span>
					<span>Usually replies within a few working days.</span>
				</div>
			</div>

			<form id="contact-form" class="contact-form" novalidate>
				<input
					type="hidden"
					name="access_key"
					value="08717993-2bd6-424b-ad6f-34da1a976e4f"
				/>
				<input
					type="hidden"
					name="subject"
					value="New project enquiry — Ariel Portfolio"
				/>
				<input type="hidden" name="from_name" value="Ariel Portfolio" />

				<!-- Honeypot anti-spam field -->
				<input
					type="checkbox"
					name="botcheck"
					class="honeypot"
					tabindex="-1"
					aria-hidden="true"
				/>

				<div class="field-row">
					<div class="form-field">
						<label for="name">Name <span>*</span></label>
						<input
							id="name"
							name="name"
							type="text"
							placeholder="Your name"
							autocomplete="name"
							required
						/>
					</div>

					<div class="form-field">
						<label for="company">Studio / Company</label>
						<input
							id="company"
							name="company"
							type="text"
							placeholder="Optional"
							autocomplete="organization"
						/>
					</div>
				</div>

				<div class="form-field">
					<label for="email">Email <span>*</span></label>
					<input
						id="email"
						name="email"
						type="email"
						placeholder="you@example.com"
						autocomplete="email"
						required
					/>
				</div>

				<div class="form-field">
					<label for="project-type">Type of project</label>
					<div class="select-wrap">
						<select id="project-type" name="project_type">
							<option value="" disabled>Select a category</option>
							<option value="Game audio">Game audio</option>
							<option value="Sound design">Sound design</option>
							<option value="Audio implementation">Audio implementation</option>
							<option value="Film / audiovisual">Film / audiovisual</option>
							<option value="Sound editing">Sound editing</option>
							<option value="Other">Other</option>
						</select>
					</div>
				</div>

				<div class="form-field">
					<label for="message">Tell me about it <span>*</span></label>
					<textarea
						id="message"
						name="message"
						rows="5"
						placeholder="A little context, deadlines, what you need..."
						required
					></textarea>
				</div>

				<button class="submit-button" type="submit">
					<span class="button-text">Send enquiry</span>
					<span class="button-arrow" aria-hidden="true">↗</span>
				</button>

				<p id="form-result" class="form-result" role="status" aria-live="polite"></p>

				<p class="form-privacy">
					Your details will only be used to respond to your enquiry.
				</p>
			</form>
		</section>

		

		<footer class="contact-footer">
			<span>ARIEL — SOUND DESIGN / AUDIO IMPLEMENTATION</span>
			<span>END OF TRANSMISSION <span class="footer-signal">●</span></span>
		</footer>
	</main>

	<script is:inline>
		const form = document.getElementById("contact-form");
		const result = document.getElementById("form-result");
		const submitButton = form?.querySelector('button[type="submit"]');
		const buttonText = form?.querySelector(".button-text");

		if (form && result && submitButton && buttonText) {
			form.addEventListener("submit", async (event) => {
				event.preventDefault();

				result.textContent = "";
				result.className = "form-result";

				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}

				const originalButtonText = buttonText.textContent;

				submitButton.disabled = true;
				buttonText.textContent = "Sending...";
				result.textContent = "Sending your enquiry...";

				try {
					const formData = new FormData(form);

					const response = await fetch(
						"https://api.web3forms.com/submit",
						{
							method: "POST",
							headers: {
								Accept: "application/json",
							},
							body: formData,
						}
					);

					const data = await response.json();

					if (!response.ok || !data.success) {
						throw new Error(
							data.message || "Your message could not be sent."
						);
					}

					result.textContent =
						"Message sent successfully. Thanks for getting in touch.";
					result.classList.add("is-success");
					form.reset();
				} catch (error) {
					result.textContent =
						error instanceof Error
							? `${error.message} Please try again or email me directly.`
							: "Something went wrong. Please email me directly.";
					result.classList.add("is-error");
				} finally {
					submitButton.disabled = false;
					buttonText.textContent = originalButtonText;
				}
			});
		}
	</script>

	<style>
		.contact-page {
			--acid: #c6ff00;
			--page-bg: #090909;
			--line: #303030;
			--muted: #999;
			width: min(100% - 48px, 1120px);
			margin-inline: auto;
			padding: clamp(64px, 10vw, 132px) 0 28px;
			color: #f3f3f0;
		}

		.contact-hero {
			position: relative;
			padding-bottom: clamp(48px, 8vw, 100px);
			border-bottom: 1px solid var(--line);
		}

		.eyebrow,
		.section-label,
		.hero-index,
		.contact-footer {
			font-family: "Courier New", monospace;
			font-size: 11px;
			letter-spacing: 0.09em;
			line-height: 1.6;
		}

		.eyebrow {
			display: flex;
			align-items: center;
			gap: 10px;
			margin: 0 0 30px;
			color: var(--acid);
		}

		.status-dot,
		.footer-signal {
			color: var(--acid);
		}

		.status-dot {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: var(--acid);
			box-shadow: 0 0 12px #c6ff0060;
		}

		.contact-hero h1 {
			margin: 0;
			max-width: 950px;
			font-size: clamp(60px, 11.5vw, 146px);
			font-weight: 500;
			letter-spacing: -0.085em;
			line-height: 0.88;
		}

		.contact-hero h1 span {
			color: var(--acid);
		}

		.intro {
			max-width: 430px;
			margin: 34px 0 0;
			color: #b2b2ad;
			font-size: clamp(16px, 2vw, 19px);
			line-height: 1.7;
		}

		.hero-index {
			display: flex;
			justify-content: space-between;
			gap: 20px;
			margin-top: 58px;
			color: #777;
		}

		.contact-form-section {
			display: grid;
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
			gap: clamp(36px, 8vw, 110px);
			padding: clamp(56px, 9vw, 105px) 0;
			border-bottom: 1px solid var(--line);
		}

		.section-label {
			margin: 0;
			color: #a5a5a0;
		}

		.form-intro h2 {
			max-width: 400px;
			margin: 28px 0 18px;
			font-size: clamp(32px, 4.2vw, 52px);
			font-weight: 500;
			letter-spacing: -0.055em;
			line-height: 1.05;
		}

		.form-intro > p:not(.section-label) {
			max-width: 340px;
			margin: 0;
			color: var(--muted);
			font-size: 15px;
			line-height: 1.75;
		}

		.form-note {
			display: flex;
			align-items: flex-start;
			gap: 12px;
			margin-top: 42px;
			color: #858580;
			font-family: "Courier New", monospace;
			font-size: 11px;
			line-height: 1.8;
		}

		.note-symbol {
			color: var(--acid);
			font-size: 18px;
			line-height: 1;
		}

		.contact-form {
			display: flex;
			flex-direction: column;
			gap: 24px;
		}

		.field-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 18px;
		}

		.form-field {
			display: flex;
			min-width: 0;
			flex-direction: column;
			gap: 10px;
		}

		.form-field label {
			color: #d6d6d1;
			font-size: 13px;
		}

		.form-field label span {
			color: var(--acid);
		}

		.form-field input,
		.form-field textarea,
		.form-field select {
			display: block;
			width: 100%;
			min-width: 0;
			padding: 15px 0;
			border: 0;
			border-bottom: 1px solid #414141;
			border-radius: 0;
			outline: none;
			background: transparent;
			color: #f3f3f0;
			font: inherit;
			font-size: 14px;
			transition: border-color 180ms ease;
		}

		.form-field textarea {
			min-height: 125px;
			resize: vertical;
			line-height: 1.65;
		}

		.form-field input::placeholder,
		.form-field textarea::placeholder {
			color: #686868;
			opacity: 1;
		}

		.form-field input:focus,
		.form-field textarea:focus,
		.form-field select:focus {
			border-color: var(--acid);
		}

		.form-field input:focus-visible,
		.form-field textarea:focus-visible,
		.form-field select:focus-visible {
			outline: 1px solid var(--acid);
			outline-offset: 4px;
		}

		.select-wrap {
			position: relative;
		}

		.select-wrap::after {
			position: absolute;
			top: 14px;
			right: 2px;
			color: var(--acid);
			content: "↓";
			pointer-events: none;
		}

		.form-field select {
			padding-right: 28px;
			appearance: none;
			color: #aaa;
			cursor: pointer;
		}

		.form-field select:valid {
			color: #f3f3f0;
		}

		.form-field select option {
			background: #111;
			color: #f3f3f0;
		}

		.submit-button {
			display: flex;
			width: 100%;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
			margin-top: 4px;
			padding: 19px 20px;
			border: 1px solid var(--acid);
			background: var(--acid);
			color: #090909;
			font: inherit;
			font-size: 14px;
			font-weight: 600;
			text-align: left;
			cursor: pointer;
			transition:
				background 180ms ease,
				color 180ms ease,
				transform 180ms ease;
		}

		.submit-button:hover:not(:disabled) {
			background: transparent;
			color: var(--acid);
		}

		.submit-button:active:not(:disabled) {
			transform: translateY(1px);
		}

		.submit-button:focus-visible {
			outline: 2px solid #f3f3f0;
			outline-offset: 4px;
		}

		.submit-button:disabled {
			cursor: wait;
			opacity: 0.65;
		}

		.button-arrow {
			font-size: 21px;
			font-weight: 400;
		}

		.form-result {
			min-height: 0;
			margin: -8px 0 0;
			color: #d7d7d2;
			font-size: 13px;
			line-height: 1.6;
		}

		.form-result:empty {
			display: none;
		}

		.form-result.is-success {
			color: var(--acid);
		}

		.form-result.is-error {
			color: #ff8b80;
		}

		.form-privacy {
			margin: -8px 0 0;
			color: #777;
			font-size: 11px;
			line-height: 1.6;
		}

		.honeypot {
			position: absolute;
			left: -9999px;
			width: 1px;
			height: 1px;
			opacity: 0;
		}

		.contact-methods {
			padding: 48px 0 0;
		}

		.methods-heading {
			margin-bottom: 20px;
		}

		.contact-method {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			padding: 25px 0;
			border-top: 1px solid var(--line);
			color: inherit;
			text-decoration: none;
			transition: padding 180ms ease;
		}

		.contact-method:last-child {
			border-bottom: 1px solid var(--line);
		}

		.contact-method:hover {
			padding-right: 8px;
			padding-left: 8px;
		}

		.contact-method .section-label {
			margin-bottom: 8px;
			color: #868680;
		}

		.contact-method h2 {
			margin: 0;
			font-size: clamp(18px, 3vw, 28px);
			font-weight: 400;
			letter-spacing: -0.035em;
			overflow-wrap: anywhere;
		}

		.contact-arrow {
			flex: 0 0 auto;
			color: var(--acid);
			font-size: 24px;
			transition: transform 180ms ease;
		}

		.contact-method:hover .contact-arrow {
			transform: translate(3px, -3px);
		}

		.contact-footer {
			display: flex;
			justify-content: space-between;
			gap: 20px;
			padding-top: 28px;
			color: #70706b;
			font-size: 10px;
		}

		@media (max-width: 700px) {
			.contact-page {
				width: min(100% - 36px, 540px);
				padding-top: 60px;
			}

			.contact-hero h1 {
				font-size: clamp(58px, 14vw, 90px);
			}

			.hero-index {
				flex-direction: column;
				gap: 6px;
				margin-top: 38px;
			}

			.contact-form-section {
				grid-template-columns: 1fr;
				gap: 38px;
				padding: 58px 0;
			}

			.form-intro h2 {
				margin-top: 20px;
			}

			.form-note {
				margin-top: 24px;
			}

			.field-row {
				grid-template-columns: 1fr;
				gap: 24px;
			}

			.contact-footer {
				flex-direction: column;
				gap: 8px;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.contact-page *,
			.contact-page *::before,
			.contact-page *::after {
				scroll-behavior: auto !important;
				transition-duration: 0.01ms !important;
				animation-duration: 0.01ms !important;
			}
		}
	</style>
</Layout>
