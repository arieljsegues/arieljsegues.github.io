
---
import Layout from "../../layouts/layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");
---

<Layout
  title="Proyectos — Ariel"
  description="Selección de proyectos de diseño sonoro, edición de sonido y audio."
  lang="es"
>
  <main>
    <section class="work-page-header">
      <p class="eyebrow">PORTFOLIO</p>
      <h1>Proyectos.</h1>
      <p class="intro">
        Una selección de trabajos de diseño sonoro, edición de sonido y audio.
      </p>
    </section>

    <section class="work-page-projects">
      <div class="projects">
        {projects.map((project) => (
          <ProjectCard project={project} lang="es" />
        ))}
      </div>
    </section>
  </main>
</Layout>
