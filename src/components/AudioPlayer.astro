---
interface Props {
	title: string;
	file: string;
}

const { title, file } = Astro.props;
---

<div class="audio-player" data-audio-player>
	<audio src={file} preload="metadata"></audio>

	<div class="player-header">
		<div class="track-title">
			<span class="track-dot"></span>
			{title}
		</div>

		<div class="time">
			<span data-current-time>0:00</span>
			<span>/</span>
			<span data-duration>0:00</span>
		</div>
	</div>

	<div class="waveform-container" data-waveform>
		<canvas></canvas>

		<button
			class="waveform-click-target"
			type="button"
			aria-label={`Seek ${title}`}
			data-seek
		></button>

		<div class="waveform-loading">
			Loading waveform...
		</div>
	</div>

	<div class="player-controls">
		<button
            class="play-button"
            type="button"
            aria-label={`Play ${title}`}
            data-play
        >
            <span class="play-icon"></span>
            <span class="pause-icon">
                <span></span>
                <span></span>
            </span>
        </button>

		<div class="player-bottom">
			<span class="player-label">SOUND DESIGN</span>

			<div class="volume-control">
				<span>VOL</span>

				<input
					type="range"
					min="0"
					max="1"
					value="0.75"
					step="0.01"
					aria-label={`Volume of ${title}`}
					data-volume
				/>
			</div>
		</div>
	</div>
</div>

<script>
	const players =
		document.querySelectorAll<HTMLElement>("[data-audio-player]");

	players.forEach((player) => {
		const audio =
			player.querySelector<HTMLAudioElement>("audio");

		const playButton =
			player.querySelector<HTMLButtonElement>("[data-play]");

		const currentTime =
			player.querySelector<HTMLElement>("[data-current-time]");

		const duration =
			player.querySelector<HTMLElement>("[data-duration]");

		const volume =
			player.querySelector<HTMLInputElement>("[data-volume]");

		const waveform =
			player.querySelector<HTMLElement>("[data-waveform]");

		const canvas =
			player.querySelector<HTMLCanvasElement>("canvas");

		const seekButton =
			player.querySelector<HTMLButtonElement>("[data-seek]");

		const loading =
			player.querySelector<HTMLElement>(".waveform-loading");

		if (
			!audio ||
			!playButton ||
			!currentTime ||
			!duration ||
			!volume ||
			!waveform ||
			!canvas ||
			!seekButton
		) {
			return;
		}

		const context = canvas.getContext("2d");

		if (!context) {
			return;
		}

		let peaks: number[] = [];

		const formatTime = (seconds: number) => {
			if (!Number.isFinite(seconds)) {
				return "0:00";
			}

			const minutes = Math.floor(seconds / 60);
			const remainingSeconds = Math.floor(seconds % 60);

			return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
		};

		const resizeCanvas = () => {
			const rect = waveform.getBoundingClientRect();
			const devicePixelRatio = window.devicePixelRatio || 1;

			canvas.width = rect.width * devicePixelRatio;
			canvas.height = rect.height * devicePixelRatio;

			canvas.style.width = `${rect.width}px`;
			canvas.style.height = `${rect.height}px`;

			context.setTransform(
				devicePixelRatio,
				0,
				0,
				devicePixelRatio,
				0,
				0
			);
		};

		const drawWaveform = (
			progressPercentage = 0
		) => {
			const width = waveform.clientWidth;
			const height = waveform.clientHeight;

			if (!width || !height || peaks.length === 0) {
				return;
			}

			resizeCanvas();

			context.clearRect(0, 0, width, height);

			const center = height / 2;

			const barWidth = 2;
			const gap = 3;
			const step = barWidth + gap;

			const visibleBars = Math.floor(width / step);

			for (let i = 0; i < visibleBars; i++) {
				const index = Math.floor(
					(i / visibleBars) * peaks.length
				);

				const peak = peaks[index] ?? 0;

				const barHeight = Math.max(
					2,
					peak * (height * 0.82)
				);

				const x = i * step;
				const y = center - barHeight / 2;

				const barProgress =
					(x / width) * 100;

				const isPlayed =
	                barProgress <= progressPercentage;

                context.fillStyle =
                    isPlayed
                        ? "#f2f2f2"
                        : "#3a3a3a";

                if (isPlayed) {
                    context.shadowColor =
                        "rgba(242, 242, 242, 0.35)";
                    context.shadowBlur = 4;
                } else {
                    context.shadowColor = "transparent";
                    context.shadowBlur = 0;
                }

                context.fillRect(
                    x,
                    y,
                    barWidth,
                    barHeight
                );

                context.shadowBlur = 0;
                            }

		};

		const loadWaveform = async () => {
			try {
				const response = await fetch(audio.src);

				if (!response.ok) {
					throw new Error("Could not load audio.");
				}

				const arrayBuffer =
					await response.arrayBuffer();

				const audioContext =
					new AudioContext();

				const audioBuffer =
					await audioContext.decodeAudioData(
						arrayBuffer
					);

				const data =
					audioBuffer.getChannelData(0);

				const samplesPerBar = Math.max(
					1,
					Math.floor(data.length / 1000)
				);

				peaks = [];

				for (
					let i = 0;
					i < data.length;
					i += samplesPerBar
				) {
					let max = 0;

					for (
						let j = 0;
						j < samplesPerBar &&
						i + j < data.length;
						j++
					) {
						const value =
							Math.abs(data[i + j]);

						if (value > max) {
							max = value;
						}
					}

					peaks.push(max);
				}

				drawWaveform();

				loading?.classList.add("is-hidden");

				window.addEventListener("resize", () => {
					const percentage =
						audio.duration
							? (audio.currentTime / audio.duration) * 100
							: 0;

					drawWaveform(percentage);
				});

				await audioContext.close();
			} catch (error) {
				console.error(
					"Waveform error:",
					error
				);

				loading?.classList.add("is-hidden");
			}
		};

		const updateProgress = () => {
			if (!audio.duration) {
				return;
			}

			const percentage =
				(audio.currentTime / audio.duration) * 100;

			currentTime.textContent =
				formatTime(audio.currentTime);

			drawWaveform(percentage);
		};

		const updateDuration = () => {
			duration.textContent =
				formatTime(audio.duration);
		};

		playButton.addEventListener("click", () => {
			if (audio.paused) {
				audio.play();
			} else {
				audio.pause();
			}
		});

		seekButton.addEventListener("click", (event) => {
			if (!audio.duration) {
				return;
			}

			const rect =
				seekButton.getBoundingClientRect();

			const mouseX =
				(event as MouseEvent).clientX -
				rect.left;

			const percentage =
				Math.max(
					0,
					Math.min(
						1,
						mouseX / rect.width
					)
				);

			audio.currentTime =
				audio.duration * percentage;

			updateProgress();
		});

		audio.addEventListener("play", () => {
			player.classList.add("is-playing");

			playButton.setAttribute(
				"aria-label",
				"Pause audio"
			);
		});

		audio.addEventListener("pause", () => {
			player.classList.remove("is-playing");

			playButton.setAttribute(
				"aria-label",
				"Play audio"
			);
		});

		audio.addEventListener("ended", () => {
			player.classList.remove("is-playing");

			currentTime.textContent =
				formatTime(audio.duration);

			drawWaveform(100);
		});

		audio.addEventListener(
			"timeupdate",
			updateProgress
		);

		audio.addEventListener(
			"loadedmetadata",
			updateDuration
		);

		const updateVolumeVisual = () => {
            const percentage =
                Number(volume.value) * 100;

            volume.style.setProperty(
                "--volume-progress",
                `${percentage}%`
            );
        };

        audio.volume = Number(volume.value);

        updateVolumeVisual();

        volume.addEventListener("input", () => {
            audio.volume =
                Number(volume.value);

            updateVolumeVisual();
        });

		loadWaveform();
	});
</script>

<style>
	.audio-player {
		position: relative;
		padding: 24px 26px 20px;
		background: #181818;
		border: 1px solid #303030;
		border-radius: 8px;
		overflow: hidden;
	}

	.player-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		margin-bottom: 18px;
		position: relative;
		z-index: 2;
	}

	.track-title {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
		color: #f2f2f2;
	}

	.track-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #666;
		transition: background 0.2s ease;
	}

	.is-playing .track-dot {
		background: #f2f2f2;
	}

	.time {
		display: flex;
		gap: 5px;
		font-size: 12px;
		color: #777;
		font-variant-numeric: tabular-nums;
	}

	.waveform-container {
		position: relative;
		height: 100px;
		cursor: pointer;
	}

	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.waveform-click-target {
		position: absolute;
		inset: 0;
		z-index: 3;
		width: 100%;
		height: 100%;
		border: 0;
		background: transparent;
		cursor: pointer;
		padding: 0;
	}

	.waveform-loading {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #555;
		pointer-events: none;
	}

	.waveform-loading.is-hidden {
		display: none;
	}

	.player-controls {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 16px;
		position: relative;
		z-index: 4;
	}

	.play-button {
		position: relative;
		width: 40px;
		height: 40px;
		border: 1px solid #444;
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		flex-shrink: 0;
	}

	.play-button:hover {
		background: #f2f2f2;
	}

	.play-icon {
		width: 0;
		height: 0;
		border-top: 6px solid transparent;
		border-bottom: 6px solid transparent;
		border-left: 9px solid #f2f2f2;
		margin-left: 2px;
	}

	.play-button:hover .play-icon {
		border-left-color: #111;
	}

	.pause-icon {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 4px;
		width: 10px;
		height: 12px;
	}

	.pause-icon span {
		display: block;
		width: 2px;
		height: 12px;
		background: #f2f2f2;
	}

	.play-button:hover .pause-icon span {
		background: #111;
	}

	.is-playing .play-icon {
		display: none;
	}

	.is-playing .pause-icon {
		display: flex;
	}

	.player-bottom {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 10px;
		letter-spacing: 0.12em;
		color: #666;
	}

	.volume-control {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.volume-control input {
		width: 80px;
		appearance: none;
		background: transparent;
		cursor: pointer;
	}

	.volume-control input::-webkit-slider-runnable-track {
		height: 2px;
		background: linear-gradient(
			to right,
			#f2f2f2 0%,
			#f2f2f2 var(--volume-progress),
			#3a3a3a var(--volume-progress),
			#3a3a3a 100%
		);
	}

	.volume-control input::-webkit-slider-thumb {
		appearance: none;
		width: 9px;
		height: 9px;
		margin-top: -3.5px;
		border: 0;
		border-radius: 50%;
		background: #f2f2f2;
	}

	.volume-control input::-moz-range-track {
		height: 2px;
		background: linear-gradient(
			to right,
			#f2f2f2 0%,
			#f2f2f2 var(--volume-progress),
			#3a3a3a var(--volume-progress),
			#3a3a3a 100%
		);
	}

	.volume-control input::-moz-range-thumb {
		width: 9px;
		height: 9px;
		border: 0;
		border-radius: 50%;
		background: #f2f2f2;
	}

	@media (max-width: 700px) {
		.audio-player {
			padding: 20px;
		}

		.waveform-container {
			height: 80px;
		}

		.player-header {
			align-items: flex-start;
		}

		.player-controls {
			gap: 14px;
		}

		.volume-control input {
			width: 80px;
		}
	}
</style>